# Port the guardrails service listens on
PORT=3000

# Path to the SQLite file used to store workflows, heartbeats, and spend
DB_PATH=./guardrails.db

# Slack incoming webhook URL used for missed-heartbeat and spend-limit alerts
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXX/YYYYYYY/ZZZZZZZZZZZZZZZZZZZZZZZZ
